{
  "expo": {
    "name": "Daily Assistant",
    "slug": "daily-assistant",
    "scheme": "dailyassistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDF2F4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nariaki.dailyassistant"
    },
    "android": {
      "package": "com.nariaki.dailyassistant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8638C"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png",
      "name": "Daily Assistant",
      "shortName": "Daily Assistant",
      "description": "Your personal daily assistant app",
      "themeColor": "#E8638C",
      "backgroundColor": "#FDF2F4"
    },
    "plugins": [
      "./plugins/withoutPushEntitlement",
      [
        "expo-notifications",
        {
          "color": "#E8638C"
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
