rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 空間有兩種存取模式,由根文件有沒有 members 欄位決定:
    //
    // 1. 沒有 members(預設):沿用「知道 10 碼配對碼即可存取」。
    //    配對碼是 31^10 ≈ 8×10^14 的隨機字串,當作 bearer token 強度足夠,
    //    而且不需要登入——免帳號共享是這個 App 原本的設計。
    //
    // 2. 有 members:只有名單內的登入帳號能存取,配對碼不再是通行證。
    //    這是使用者到設定頁「鎖定空間」後才會發生的事,不會自動升級——
    //    自動升級會把沒有帳號的伴侶直接鎖在門外。
    function allowed(data) {
      return !('members' in data)
             || (request.auth != null && request.auth.uid in data.members);
    }

    function spaceData(spaceId) {
      return get(/databases/$(database)/documents/spaces/$(spaceId)).data;
    }

    match /spaces/{spaceId} {
      allow get: if allowed(resource.data);

      // 建立時若帶 members,必須包含自己,免得有人替別人建立鎖死的空間
      allow create: if !('members' in request.resource.data)
                    || (request.auth != null
                        && request.auth.uid in request.resource.data.members);

      // 改動後的名單也必須包含自己:防止把空間鎖給別人、或把自己鎖在外面
      allow update: if allowed(resource.data) && allowed(request.resource.data);

      // 禁止列舉所有空間,也不開放刪除
      allow list, delete: if false;

      // 子集合沿用根文件的存取判斷(每次會多一次文件讀取,兩人使用量下可忽略)
      match /{collectionName}/{docId} {
        allow read, write: if allowed(spaceData(spaceId));
      }
    }

    // 帳號 → 共享空間綁定:只有本人(已登入)可讀寫
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Google refresh token 由 Functions 以 Admin SDK 存取,前端一律擋掉
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
